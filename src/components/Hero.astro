---
import { profile } from '../data/profile';

const firstName = profile.name.split(' ')[0];
---

<header class="hero" id="top">
  <div class="copy">
    <p class="kicker">
      {profile.role} <span aria-hidden="true">·</span> {profile.location}
    </p>

    <h1>
      <span class="greet">Hi, I'm</span>{' '}
      <span class="who">{firstName}</span>
    </h1>

    {profile.tagline && <p class="tagline">{profile.tagline}</p>}

    {
      profile.employer && (
        <div class="employer">
          <span class="employer-label">{profile.employer.label}</span>
          <img
            class="employer-logo"
            src={profile.employer.logo}
            alt={profile.employer.name}
            width="96"
            height="96"
          />
        </div>
      )
    }
  </div>

  {
    profile.heroImage && (
      <div class="hero-visual">
        <img
          src={profile.heroImage}
          alt={profile.heroImageAlt}
          width="640"
          height="588"
        />
      </div>
    )
  }

  <a class="scroll-cue" href="#about" aria-label="Scroll to introduction">
    <span class="dot" aria-hidden="true"></span>
  </a>
</header>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - var(--header-h));
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    padding-block: var(--space-6) var(--space-7);
    text-align: center;
  }

  .kicker {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .hero h1 {
    margin-top: var(--space-3);
    font-size: var(--step-4);
    line-height: 1.02;
    letter-spacing: -0.025em;
  }

  .greet {
    color: var(--text);
  }

  /* The name is the one thing that should carry colour. */
  .who {
    color: var(--accent-text);
  }

  .tagline {
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }

  .employer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .employer-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .employer-logo {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--bg);
    object-fit: contain;
    padding: 0.3rem;
  }

  /* Sized against viewport height so the whole hero always fits one screen,
     including on short laptop viewports. */
  .hero-visual {
    display: flex;
    justify-content: center;
    min-height: 0;
  }

  .hero-visual img {
    display: block;
    width: auto;
    height: auto;
    max-height: min(40svh, 21rem);
    max-width: 100%;
  }

  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: var(--space-3);
    translate: -50% 0;
    width: 1.5rem;
    height: 2.4rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    display: grid;
    justify-items: center;
    padding-top: 0.45rem;
  }

  .dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent);
    animation: nudge 1.8s var(--ease) infinite;
  }

  @keyframes nudge {
    0%, 100% { transform: translateY(0); opacity: 1; }
    50% { transform: translateY(0.7rem); opacity: 0.35; }
  }

  @media (min-width: 62rem) {
    .hero-visual img {
      max-height: min(44svh, 25rem);
    }
  }
</style>
