---
import { profile } from '../data/profile';

// Inline monochrome marks: they inherit currentColor, so they theme with the
// page and cost no extra requests.
const links = [
  {
    label: 'Email',
    href: `mailto:${profile.email}`,
    rel: undefined,
    path: 'M1.5 8.67v8.58a3 3 0 003 3h15a3 3 0 003-3V8.67l-8.928 5.493a3 3 0 01-3.144 0L1.5 8.67zM22.5 6.908V6.75a3 3 0 00-3-3h-15a3 3 0 00-3 3v.158l9.714 5.978a1.5 1.5 0 001.572 0L22.5 6.908z',
  },
  {
    label: 'LinkedIn',
    href: profile.links.linkedin,
    rel: 'me noopener',
    path: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
  },
  {
    label: 'GitHub',
    href: profile.links.github,
    rel: 'me noopener',
    path: 'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12',
  },
  ...(profile.resume
    ? [
        {
          label: 'Résumé (PDF)',
          href: profile.resume,
          rel: undefined,
          path: 'M5.625 1.5H9a3.75 3.75 0 013.75 3.75v1.875c0 1.036.84 1.875 1.875 1.875H16.5a3.75 3.75 0 013.75 3.75v7.5a3 3 0 01-3 3H5.625a3 3 0 01-3-3V4.5a3 3 0 013-3zm8.625 0c1.148 0 2.219.343 3.113.932A5.99 5.99 0 0119.5 6.75v.75h-3.75a.375.375 0 01-.375-.375V5.25c0-1.148-.343-2.219-.932-3.113A5.99 5.99 0 0014.25 1.5z',
        },
      ]
    : []),
];
---

<ul class="contact-links">
  {
    links.map((l) => (
      <li>
        <a href={l.href} rel={l.rel} aria-label={l.label} title={l.label}>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d={l.path} />
          </svg>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
    color: var(--text-muted);
    transition:
      color 0.16s var(--ease),
      border-color 0.16s var(--ease),
      transform 0.16s var(--ease);
  }

  a:hover {
    color: var(--accent-text);
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: currentColor;
  }
</style>
