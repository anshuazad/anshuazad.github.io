---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Timeline from '../components/Timeline.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SkillGroup from '../components/SkillGroup.astro';
import { profile, education } from '../data/profile';
import { experience } from '../data/experience';
import { skills } from '../data/skills';
import { achievements } from '../data/achievements';

const projects = (await getCollection('projects', (p) => !p.data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base>
  <div class="page">
    <Hero />

    <main id="main">
      <Section title="Introduction" id="about">
        <p class="lede">{profile.headline}</p>
        <p class="muted intro-pitch">{profile.pitch}</p>
        <ul class="intro-links">
          <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
          <li>
            <a href={profile.links.linkedin} rel="me noopener">LinkedIn</a>
          </li>
          <li><a href={profile.links.github} rel="me noopener">GitHub</a></li>
          {
            profile.resume && (
              <li>
                <a href={profile.resume}>Résumé (PDF)</a>
              </li>
            )
          }
        </ul>
      </Section>

      <Section title="Selected projects" id="projects">
        {
          projects.length > 0 ? (
            projects.map((project) => <ProjectCard project={project} />)
          ) : (
            <div class="empty">
              <p>
                Writeups are in progress. In the meantime, the code is on{' '}
                <a href={profile.links.github} rel="noopener">
                  GitHub
                </a>{' '}
                — including two quantitative research frameworks and a mobile
                product build.
              </p>
            </div>
          )
        }
      </Section>

      <Section title="Experience" id="experience">
        <Timeline companies={experience} />
      </Section>

      <Section title="Skills" id="skills">
        {skills.map((group) => <SkillGroup group={group} />)}
      </Section>

      <Section title="Education" id="education">
        <div class="edu panel">
          <div class="edu-head">
            {
              education.logo ? (
                <img
                  class="edu-badge"
                  src={education.logo}
                  alt=""
                  width="96"
                  height="96"
                  loading="lazy"
                />
              ) : (
                <span class="edu-badge is-initials" aria-hidden="true">
                  {education.short}
                </span>
              )
            }
            <div>
              <h3 class="inst">{education.institution}</h3>
              <p class="meta-line">{education.period}</p>
            </div>
          </div>

          <p class="muted degree">
            {education.degree} <span aria-hidden="true">·</span>{' '}
            {education.extra}
          </p>

          <p class="badge cgpa">{education.detail}</p>

          {
            education.activities.length > 0 && (
              <ul class="activities">
                {education.activities.map((a) => (
                  <li>{a}</li>
                ))}
              </ul>
            )
          }
        </div>
      </Section>

      <Section title="Achievements" id="achievements">
        <ul class="awards">
          {
            achievements.map((a) => (
              <li class="award panel">
                <div class="award-head">
                  <div class="award-id">
                    {a.icon ? (
                      <svg
                        class="award-mark"
                        viewBox={a.viewBox ?? '0 0 24 24'}
                        style={`--scale: ${a.scale ?? 1};`}
                        aria-hidden="true"
                        focusable="false"
                      >
                        <path d={a.icon} />
                      </svg>
                    ) : a.mask ? (
                      <span
                        class="award-mark is-mask"
                        aria-hidden="true"
                        style={`--mark: url('${a.mask}'); --scale: ${a.scale ?? 1};`}
                      />
                    ) : a.short ? (
                      <span class="award-mark is-initials" aria-hidden="true">
                        {a.short}
                      </span>
                    ) : null}
                    <h3 class="award-title">{a.title}</h3>
                  </div>
                  <p class="meta-line">{a.year}</p>
                </div>
                <p class="badge award-result">{a.result}</p>
                {a.note && <p class="award-note muted">{a.note}</p>}
              </li>
            ))
          }
        </ul>
      </Section>

      <Section title="Contact" id="contact">
        <p class="muted">
          Open to conversations about data science and applied GenAI roles.
        </p>
        <p class="contact-links">
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
          <span aria-hidden="true">·</span>
          <a href={profile.links.linkedin} rel="me noopener">LinkedIn</a>
          <span aria-hidden="true">·</span>
          <a href={profile.links.github} rel="me noopener">GitHub</a>
        </p>
      </Section>
    </main>
  </div>
</Base>

<style>
  .lede {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.01em;
    max-width: 30ch;
    text-wrap: balance;
  }
  .intro-pitch {
    margin-top: var(--space-3);
    max-width: var(--measure);
  }
  .intro-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
  }
  .intro-links a {
    text-decoration: none;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border-strong);
    padding-bottom: 0.1rem;
    transition: color 0.16s var(--ease), border-color 0.16s var(--ease);
  }
  .intro-links a:hover {
    color: var(--accent-text);
    border-bottom-color: var(--accent);
  }
  .empty {
    padding: var(--space-3);
    background: var(--surface);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius);
    color: var(--text-muted);
  }
  /* ── Education ─────────────────────────────────────────────────────── */
  .edu-head {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  /* Institution crests are circular, unlike the rectangular company
     lockups, so this badge is round rather than a rounded square. The crest
     is dark blue ink on transparent, so it needs a light plate to stay
     legible on the dark theme. */
  .edu-badge {
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    max-width: none;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: #fff;
    object-fit: contain;
    padding: 0.15rem;
  }
  .edu-badge.is-initials {
    display: grid;
    place-items: center;
    background: var(--bg);
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--text-muted);
  }
  .inst {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }
  .edu-head .meta-line {
    margin-top: 0.2rem;
  }
  .degree {
    margin-top: var(--space-2);
    font-size: 0.9375rem;
  }
  .cgpa {
    margin-top: var(--space-2);
  }
  .activities {
    margin: var(--space-3) 0 0;
    padding-left: 1.1rem;
    color: var(--text-muted);
    font-size: 0.9375rem;
  }
  .activities li {
    list-style: disc;
  }
  .activities li + li {
    margin-top: var(--space-1);
  }

  /* ── Achievements ──────────────────────────────────────────────────── */
  .awards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  @media (min-width: 48rem) {
    .awards {
      grid-template-columns: 1fr 1fr;
    }
  }
  .award-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-2);
  }
  .award-id {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
  }
  /* Marks render in currentColor, so all four read as one set. */
  /* Every mark gets the same slot and is scaled to fit inside it, so the
     logos occupy a uniform footprint despite aspect ratios from 0.52
     (Inter IIT, tall) to 3.64 (FedEx, wide). SVGs fit via the default
     preserveAspectRatio; the masked bitmap via mask-size: contain. */
  .award-mark {
    flex: none;
    /* Slot is wider than tall so a wordmark has room; per-mark --scale
       balances height. Measured ink coverage across these four varies ~10x,
       so a single height cannot make them read as one size. */
    width: 2.8rem;
    height: calc(1.5rem * var(--scale, 1));
    color: var(--text-muted);
    fill: currentColor;
  }
  .award-mark.is-mask {
    background: currentColor;
    -webkit-mask: var(--mark) center / contain no-repeat;
    mask: var(--mark) center / contain no-repeat;
  }
  .award-mark.is-initials {
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    border: 1px solid var(--border);
    border-radius: 6px;
  }
  .award-title {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.35;
  }
  .award-result {
    margin-top: var(--space-2);
  }
  .award-note {
    margin-top: var(--space-2);
    font-size: 0.875rem;
  }
  .contact-links {
    margin-top: var(--space-2);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    color: var(--text-faint);
  }
</style>
