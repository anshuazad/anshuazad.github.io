---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Timeline from '../components/Timeline.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SkillGroup from '../components/SkillGroup.astro';
import ContactLinks from '../components/ContactLinks.astro';
import { profile, education } from '../data/profile';
import { experience } from '../data/experience';
import { skills } from '../data/skills';
import { achievements } from '../data/achievements';

const projects = (await getCollection('projects', (p) => !p.data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base>
  <div class="page">
    <Hero />

    <main id="main">
      <Section title="Introduction" id="about">
        <p class="lede">{profile.headline}</p>
        <p class="muted intro-pitch">{profile.pitch}</p>
        <ContactLinks />
      </Section>

      <Section title="Selected projects" id="projects">
        {
          projects.length > 0 ? (
            projects.map((project) => <ProjectCard project={project} />)
          ) : (
            <div class="empty">
              <p>
                Writeups are in progress. In the meantime, the code is on{' '}
                <a href={profile.links.github} rel="noopener">
                  GitHub
                </a>{' '}
                — including two quantitative research frameworks and a mobile
                product build.
              </p>
            </div>
          )
        }
      </Section>

      <Section title="Experience" id="experience">
        <Timeline companies={experience} />
      </Section>

      <Section title="Skills" id="skills">
        {skills.map((group) => <SkillGroup group={group} />)}
      </Section>

      <Section title="Education" id="education">
        <div class="edu panel">
          <div class="edu-head">
            {
              education.logo ? (
                <img
                  class="edu-badge logo-plate"
                  src={education.logo}
                  alt=""
                  width="96"
                  height="96"
                  loading="lazy"
                />
              ) : (
                <span class="edu-badge logo-plate is-initials" aria-hidden="true">
                  {education.short}
                </span>
              )
            }
            <div>
              <h3 class="inst">{education.institution}</h3>
              <p class="meta-line">{education.period}</p>
            </div>
          </div>

          <p class="muted degree">
            {education.degree} <span aria-hidden="true">·</span>{' '}
            {education.extra}
          </p>

          <p class="badge cgpa">{education.detail}</p>

          {
            education.activities.length > 0 && (
              <ul class="activities">
                {education.activities.map((a) => (
                  <li>{a}</li>
                ))}
              </ul>
            )
          }
        </div>
      </Section>

      <Section title="Achievements" id="achievements">
        <ul class="awards">
          {
            achievements.map((a) => (
              <li class="award panel">
                <div class="award-head">
                  <div class="award-id">
                    {a.logo ? (
                      <img
                        class="award-mark logo-plate"
                        src={a.logo}
                        alt=""
                        width="96"
                        height="96"
                        loading="lazy"
                      />
                    ) : a.short ? (
                      <span class="award-mark logo-plate is-initials" aria-hidden="true">
                        {a.short}
                      </span>
                    ) : null}
                    <h3 class="award-title">{a.title}</h3>
                  </div>
                  <p class="meta-line">{a.year}</p>
                </div>
                <p class="badge award-result">{a.result}</p>
                {a.note && <p class="award-note muted">{a.note}</p>}
              </li>
            ))
          }
        </ul>
      </Section>

      <Section title="Contact" id="contact">
        <p class="muted">
          Open to conversations about data science and applied GenAI roles.
        </p>
        <p class="contact-email">
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
        </p>
        <ContactLinks />
      </Section>
    </main>
  </div>
</Base>

<style>
  .lede {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.01em;
    max-width: 30ch;
    text-wrap: balance;
  }
  .intro-pitch {
    margin-top: var(--space-3);
    max-width: var(--measure);
  }
  .empty {
    padding: var(--space-3);
    background: var(--surface);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius);
    color: var(--text-muted);
  }
  /* ── Education ─────────────────────────────────────────────────────── */
  .edu-head {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .inst {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }
  .edu-head .meta-line {
    margin-top: 0.2rem;
  }
  .degree {
    margin-top: var(--space-2);
    font-size: 0.9375rem;
  }
  .cgpa {
    margin-top: var(--space-2);
  }
  .activities {
    margin: var(--space-3) 0 0;
    padding-left: 1.1rem;
    color: var(--text-muted);
    font-size: 0.9375rem;
  }
  .activities li {
    list-style: disc;
  }
  .activities li + li {
    margin-top: var(--space-1);
  }

  /* ── Achievements ──────────────────────────────────────────────────── */
  .awards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  @media (min-width: 48rem) {
    .awards {
      grid-template-columns: 1fr 1fr;
    }
  }
  /* Centred, not baseline-aligned: the logo plate is twice the title's
     height, so a shared baseline drags the year well below the title. */
  .award-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-1) var(--space-2);
  }
  .award-id {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
  }
  .award-title {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.35;
  }
  .award-result {
    margin-top: var(--space-2);
  }
  .award-note {
    margin-top: var(--space-2);
    font-size: 0.875rem;
  }
  /* Address stays as copyable text; the icon row is additive. */
  .contact-email {
    margin-top: var(--space-2);
    font-size: 0.9375rem;
  }
</style>
